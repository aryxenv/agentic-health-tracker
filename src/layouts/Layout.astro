---
import '../styles/global.css';

interface Props {
  title?: string;
}

const { title = 'Health & Activity Tracker — Instrument Panel' } = Astro.props;
---

<!doctype html>
<html lang="en" class="dark">
  <head>
    <meta charset="UTF-8" />
    <meta name="description" content="Precision Health & Activity Tracker — The Instrument Panel" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <title>{title}</title>
    <!-- Google Fonts: Manrope (Variable 200..800) -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Manrope:wght@300;400;500;600;700;800&display=swap" rel="stylesheet">
  </head>
  <body class="bg-[#000000] text-white h-screen h-[100dvh] overflow-hidden relative font-['Manrope','Segoe_UI',sans-serif]">
    <!-- Reactor Blue Ambient Shader/Glow Plane behind all content (DESIGN.md §2 Colors) -->
    <div
      class="fixed inset-0 pointer-events-none z-0"
      style="background: radial-gradient(circle at 50% 15%, #1000C4 0%, #000062 40%, #000000 75%); opacity: 0.28; filter: blur(50px);"
      aria-hidden="true"
    ></div>

    <!-- Content Plane at z-1 (The Blue Stays Behind Glass) -->
    <div class="relative z-1 h-full h-[100dvh] flex flex-col overflow-hidden">
      <slot />
    </div>
  </body>
</html>
