# Groq API Key
GROQ_API_KEY=gsk_your_groq_api_key_here

# Azure Table Storage (Required for persistent cloud storage; fallback to in-memory store if unset)
AZURE_TABLES_CONNECTION_STRING=DefaultEndpointsProtocol=https;AccountName=...;AccountKey=...;EndpointSuffix=core.windows.net

ENVIRONMENT=development
